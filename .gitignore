# Built objects, the isolated executable, and local install pointers.
/build/
/baserom/*.exe
/baserom/*.dll
/retail_bin/
/orig/**
!/orig/sum-pc/
!/orig/sum-pc/.gitkeep
/assets/**
!/assets/.gitkeep
/project.local.json
/reccmp-user.yml
/reccmp-build.yml

# Generated by configure.py
/objdiff.json
/build.ninja
/compile_commands.json

# Extracted retail archives already on disk. Never commit game data.
/VPP/
/notes/tbl_map.md
/notes/tbl_map.json

# decomp-toolkit binary. Downloaded, not part of the source.
/tools/bin/
/tools/*.exe

# Compiler and editor noise
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib
*.idb
*.ncb
*.suo
*.user
.vs/
__pycache__/
*.pyc
